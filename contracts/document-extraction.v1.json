        },
        "emissionPlace": {
          "$ref": "#/$defs/CsfField",
          "description": "The place half of «Lugar y Fecha de Emisión»"
        },
        "exteriorNumber": {
          "$ref": "#/$defs/CsfField"
        },
        "firstSurname": {
          "$ref": "#/$defs/CsfField"
        },
        "givenNames": {
          "$ref": "#/$defs/CsfField"
        },
        "idCif": {
          "$ref": "#/$defs/CsfField"
        },
        "interiorNumber": {
          "$ref": "#/$defs/CsfField"
        },
        "lastStatusChangeDate": {
          "$ref": "#/$defs/CsfField"
        },
        "legalName": {
          "$ref": "#/$defs/CsfField",
          "description": "Denominación/Razón Social (persona moral)"
        },
        "locality": {
          "$ref": "#/$defs/CsfField"
        },
        "municipality": {
          "$ref": "#/$defs/CsfField"
        },
        "neighborhood": {
          "$ref": "#/$defs/CsfField"
        },
        "operationsStartDate": {
          "$ref": "#/$defs/CsfField"
        },
        "padronStatus": {
          "$ref": "#/$defs/CsfField"
        },
        "postalCode": {
          "$ref": "#/$defs/CsfField"
        },
        "regimenCapital": {
          "$ref": "#/$defs/CsfField"
        },
        "rfc": {
          "$ref": "#/$defs/CsfField"
        },
        "secondSurname": {
          "$ref": "#/$defs/CsfField"
        },
        "state": {
          "$ref": "#/$defs/CsfField"
        },
        "streetName": {
          "$ref": "#/$defs/CsfField"
        },
        "streetType": {
          "$ref": "#/$defs/CsfField"
        },
        "tradeName": {
          "$ref": "#/$defs/CsfField"
        }
      },
      "required": [
        "rfc",
        "curp",
        "legalName",
        "regimenCapital",
        "givenNames",
        "firstSurname",
        "secondSurname",
        "idCif",
        "tradeName",
        "postalCode",
        "streetType",
        "streetName",
        "exteriorNumber",
        "interiorNumber",
        "neighborhood",
        "locality",
        "municipality",
        "state",
        "betweenStreet",
        "andStreet",
        "operationsStartDate",
        "padronStatus",
        "lastStatusChangeDate",
        "emissionPlace",
        "emissionDate"
      ],
      "title": "CsfFields",
      "type": "object"
    },
    "CsfLegalForm": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "value": {
          "enum": [
            "persona_fisica",
            "persona_moral",
            "unknown"
          ],
