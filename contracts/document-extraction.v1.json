    "DocumentType": {
      "enum": [
        "bank_statement",
        "receipt",
        "invoice",
        "csf",
        "opinion_32d",
        "id_document",
        "letterhead_document",
        "unknown"
      ],
      "title": "DocumentType",
      "type": "string"
    },
