{
  "$defs": {
    "Csf": {
      "additionalProperties": false,
      "properties": {
        "economicActivities": {
          "items": {
            "$ref": "#/$defs/CsfActivity"
          },
          "title": "Economicactivities",
          "type": "array"
        },
        "economicActivitiesStatus": {
          "$ref": "#/$defs/CsfTableStatus"
        },
        "fields": {
          "$ref": "#/$defs/CsfFields"
        },
        "legalForm": {
          "$ref": "#/$defs/CsfLegalForm"
        },
        "obligations": {
          "items": {
            "$ref": "#/$defs/CsfObligation"
          },
          "title": "Obligations",
          "type": "array"
        },
        "obligationsStatus": {
          "$ref": "#/$defs/CsfTableStatus"
        },
        "qr": {
          "$ref": "#/$defs/CsfQr"
        },
        "quality": {
          "$ref": "#/$defs/CsfQuality"
        },
        "regimenes": {
          "items": {
            "$ref": "#/$defs/CsfRegimen"
          },
          "title": "Regimenes",
          "type": "array"
        },
        "regimenesStatus": {
          "$ref": "#/$defs/CsfTableStatus"
        },
        "seal": {
          "$ref": "#/$defs/CsfSeal"
        }
      },
      "required": [
        "legalForm",
        "fields",
        "regimenesStatus",
        "economicActivitiesStatus",
        "obligationsStatus",
        "qr",
        "seal",
        "quality"
      ],
      "title": "Csf",
      "type": "object"
    },
    "CsfActivity": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "x0, top, x1, bottom from the top-left corner: PDF points for a PDF, pixels of the image as displayed",
          "title": "Bbox"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CsfCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "endDate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enddate"
        },
        "lowConfidence": {
          "title": "Lowconfidence",
          "type": "boolean"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "maximum": 999,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "percentage": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percentage"
        },
        "startDate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Startdate"
        }
      },
      "required": [
        "confidence",
        "lowConfidence",
        "page",
        "name"
      ],
      "title": "CsfActivity",
      "type": "object"
    },
    "CsfCheck": {
      "enum": [
        "format_ok",
        "format_failed",
        "label_fuzzy",
        "value_wrapped",
        "low_word_confidence",
        "qr_agrees",
        "qr_disagrees",
        "seal_agrees",
        "seal_disagrees"
      ],
      "title": "CsfCheck",
      "type": "string"
    },
    "CsfField": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "x0, top, x1, bottom from the top-left corner: PDF points for a PDF, pixels of the image as displayed",
          "title": "Bbox"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CsfCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "lowConfidence": {
          "description": "confidence under 0.6: present it as doubtful",
          "title": "Lowconfidence",
          "type": "boolean"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/CsfSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/CsfFieldStatus"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "As printed; dates as ISO YYYY-MM-DD; null when blank or not found",
          "title": "Value"
        }
      },
      "required": [
        "status",
        "confidence",
        "lowConfidence"
      ],
      "title": "CsfField",
      "type": "object"
    },
    "CsfFieldStatus": {
      "enum": [
        "read",
        "invalid",
        "blank",
        "not_found",
        "not_applicable"
      ],
      "title": "CsfFieldStatus",
      "type": "string"
    },
    "CsfFields": {
      "additionalProperties": false,
      "properties": {
        "andStreet": {
          "$ref": "#/$defs/CsfField"
        },
        "betweenStreet": {
          "$ref": "#/$defs/CsfField"
        },
        "curp": {
          "$ref": "#/$defs/CsfField"
        },
